+/* Persisted keys. Windows keeps a named key in its key storage provider, so that another
+ * process can open it by name; Xbox's XAL keeps its device key that way and finds it again
+ * at every start (a new one each time makes every start a new device, which signs the user
+ * out). They are kept here in the registry, under the user's or the machine's hive, one
+ * subkey per name: the algorithm, and the private key blob protected with DPAPI. */
+static const WCHAR keys_path[] = L"Software\\Wine\\NCrypt\\Keys";
+
+static HKEY open_key_store(DWORD machine, BOOL create)
+{
+    HKEY root = machine ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER, hkey;
+    LSTATUS ret;
+
+    if (create) ret = RegCreateKeyExW(root, keys_path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &hkey, NULL);
+    else ret = RegOpenKeyExW(root, keys_path, 0, KEY_ALL_ACCESS, &hkey);
+    return ret ? NULL : hkey;
+}
+
+/* A registry key name cannot hold a backslash. */
+static WCHAR *store_name(const WCHAR *name)
+{
+    WCHAR *ret, *p;
+    if (!(ret = wcsdup(name))) return NULL;
+    for (p = ret; *p; p++) if (*p == '\\') *p = '/';
+    return ret;
+}
+
+static BOOL stored_key_exists(const WCHAR *name, DWORD machine)
+{
+    HKEY store, hkey;
+    WCHAR *sub;
+    BOOL ret = FALSE;
+
+    if (!(store = open_key_store(machine, FALSE))) return FALSE;
+    if ((sub = store_name(name)))
+    {
+        if (!RegOpenKeyExW(store, sub, 0, KEY_READ, &hkey))
+        {
+            RegCloseKey(hkey);
+            ret = TRUE;
+        }
+        free(sub);
+    }
+    RegCloseKey(store);
+    return ret;
+}
+
+static const WCHAR *private_blob_type(enum algid algid)
+{
+    switch (algid)
+    {
+    case RSA:        return BCRYPT_RSAFULLPRIVATE_BLOB;
+    case ECDSA_P256: return BCRYPT_ECCPRIVATE_BLOB;
+    default:         return NULL;
+    }
+}
+
+static SECURITY_STATUS store_key(const struct key *key)
+{
+    const WCHAR *type = private_blob_type(key->algid);
+    const WCHAR *alg = key->algid == RSA ? BCRYPT_RSA_ALGORITHM : BCRYPT_ECDSA_P256_ALGORITHM;
+    DATA_BLOB plain, sealed = {0};
+    SECURITY_STATUS ret = NTE_INTERNAL_ERROR;
+    HKEY store, hkey;
+    WCHAR *sub = NULL;
+    ULONG size;
+
+    if (!type) return NTE_NOT_SUPPORTED;
+    if (BCryptExportKey(key->bcrypt_key, NULL, type, NULL, 0, &size, 0)) return NTE_INTERNAL_ERROR;
+    if (!(plain.pbData = malloc(size))) return NTE_NO_MEMORY;
+    plain.cbData = size;
+    if (BCryptExportKey(key->bcrypt_key, NULL, type, plain.pbData, size, &size, 0)) goto done;
+    if (!CryptProtectData(&plain, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &sealed)) goto done;
+    if (!(store = open_key_store(key->machine, TRUE))) goto done;
+    if ((sub = store_name(key->name)) && !RegCreateKeyExW(store, sub, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &hkey, NULL))
+    {
+        if (!RegSetValueExW(hkey, L"Algorithm", 0, REG_SZ, (const BYTE *)alg, (lstrlenW(alg) + 1) * sizeof(WCHAR)) &&
+            !RegSetValueExW(hkey, L"Blob", 0, REG_BINARY, sealed.pbData, sealed.cbData))
+            ret = ERROR_SUCCESS;
+        RegCloseKey(hkey);
+    }
+    RegCloseKey(store);
+done:
+    SecureZeroMemory(plain.pbData, plain.cbData);
+    free(plain.pbData);
+    LocalFree(sealed.pbData);
+    free(sub);
+    if (ret) ERR("could not keep key %s\n", wine_dbgstr_w(key->name));
+    return ret;
+}
+
+static SECURITY_STATUS unstore_key(const WCHAR *name, DWORD machine)
+{
+    HKEY store;
+    WCHAR *sub;
+    LSTATUS ret = ERROR_FILE_NOT_FOUND;
+
+    if (!(store = open_key_store(machine, FALSE))) return NTE_BAD_KEYSET;
+    if ((sub = store_name(name)))
+    {
+        ret = RegDeleteTreeW(store, sub);
+        free(sub);
+    }
+    RegCloseKey(store);
+    return ret ? NTE_BAD_KEYSET : ERROR_SUCCESS;
+}
