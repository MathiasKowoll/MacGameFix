                                      const WCHAR *name, DWORD keyspec, DWORD flags)
 {
-    FIXME("(%#Ix, %p, %s, %#lx, %#lx): stub\n", provider, key, wine_dbgstr_w(name), keyspec, flags);
-    return NTE_NOT_SUPPORTED;
+    DWORD machine = flags & NCRYPT_MACHINE_KEY_FLAG, size, type, bitlen;
+    BCRYPT_ALG_HANDLE alg_handle;
+    WCHAR alg[64], *sub;
+    DATA_BLOB sealed = {0}, plain = {0};
+    struct object *object = NULL;
+    SECURITY_STATUS ret = NTE_BAD_KEYSET;
+    enum algid algid;
+    HKEY store, hkey;
+    NTSTATUS status;
+
+    TRACE("(%#Ix, %p, %s, %#lx, %#lx)\n", provider, key, wine_dbgstr_w(name), keyspec, flags);
+
+    if (!provider) return NTE_INVALID_HANDLE;
+    if (!key || !name) return NTE_INVALID_PARAMETER;
+    if (!(store = open_key_store(machine, FALSE))) return NTE_BAD_KEYSET;
+    if (!(sub = store_name(name)))
+    {
+        RegCloseKey(store);
+        return NTE_NO_MEMORY;
+    }
+    if (RegOpenKeyExW(store, sub, 0, KEY_READ, &hkey))
+    {
+        free(sub);
+        RegCloseKey(store);
+        return NTE_BAD_KEYSET;
+    }
+    free(sub);
+    RegCloseKey(store);
+
+    size = sizeof(alg);
+    if (RegQueryValueExW(hkey, L"Algorithm", NULL, &type, (BYTE *)alg, &size) || type != REG_SZ) goto done;
+    if (!lstrcmpiW(alg, BCRYPT_RSA_ALGORITHM)) { algid = RSA; alg_handle = BCRYPT_RSA_ALG_HANDLE; }
+    else if (!lstrcmpiW(alg, BCRYPT_ECDSA_P256_ALGORITHM)) { algid = ECDSA_P256; alg_handle = BCRYPT_ECDSA_P256_ALG_HANDLE; }
+    else goto done;
+    if (RegQueryValueExW(hkey, L"Blob", NULL, &type, NULL, &size) || type != REG_BINARY) goto done;
+    if (!(sealed.pbData = malloc(size))) { ret = NTE_NO_MEMORY; goto done; }
+    sealed.cbData = size;
+    if (RegQueryValueExW(hkey, L"Blob", NULL, NULL, sealed.pbData, &size)) goto done;
+    if (!CryptUnprotectData(&sealed, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &plain)) goto done;
+
+    if (!(object = create_key_object(algid, provider))) { ret = NTE_NO_MEMORY; goto done; }
+    status = BCryptImportKeyPair(alg_handle, NULL, private_blob_type(algid), &object->key.bcrypt_key,
+                                 plain.pbData, plain.cbData, 0);
+    if (status)
+    {
+        WARN("could not import kept key %s: %#lx\n", wine_dbgstr_w(name), status);
+        free(object);
+        object = NULL;
+        ret = map_ntstatus(status);
+        goto done;
+    }
+    bitlen = algid == RSA ? ((BCRYPT_RSAKEY_BLOB *)plain.pbData)->BitLength : 256;
+    set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&bitlen, sizeof(bitlen));
+    set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&bitlen, sizeof(bitlen));
+    if (!(object->key.name = wcsdup(name)))
+    {
+        NCryptFreeObject((NCRYPT_HANDLE)object);
+        object = NULL;
+        ret = NTE_NO_MEMORY;
+        goto done;
+    }
+    object->key.machine = machine;
+    *key = (NCRYPT_KEY_HANDLE)object;
+    ret = ERROR_SUCCESS;
+
+done:
+    RegCloseKey(hkey);
+    if (plain.pbData)
+    {
+        SecureZeroMemory(plain.pbData, plain.cbData);
+        LocalFree(plain.pbData);
+    }
+    free(sealed.pbData);
+    return ret;
 }
 
