+/* Each emulated instruction costs a trap, and with the leaf extended by default a program
+ * may use one in a hot path. Say how often, at 1, 10, 100... times, so that shows in a log. */
+static void note_emulated( const char *what, unsigned int *count )
+{
+    unsigned int n = __atomic_add_fetch( count, 1, __ATOMIC_RELAXED ), p = 1;
+
+    while (p < n && p <= 100000000) p *= 10;
+    if (p == n) ERR_(seh)( "emulated %s %u time%s\n", what, n, n == 1 ? "" : "s" );
+}
+
