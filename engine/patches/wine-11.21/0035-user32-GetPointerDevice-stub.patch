From: NotProtonNot <332734261+NotProtonNot@users.noreply.github.com>
Subject: GetPointerDevice exists and fails with ERROR_INVALID_PARAMETER, for games that import it (2XKO). From NotProton's creator

Patch by NotProton's creator (https://github.com/NotProtonNot/NotProton), handed to
MacGameFix. Only the file name changed here; the diff is theirs as given.

--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -468,6 +468,19 @@
 }
 
 /**********************************************************************
+ * GetPointerDevice [USER32.@]
+ */
+BOOL WINAPI GetPointerDevice(HANDLE device, POINTER_DEVICE_INFO *info)
+{
+    static int once;
+
+    if (!once++) FIXME("(%p %p): stub\n", device, info);
+
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/**********************************************************************
  * GetPointerDevices [USER32.@]
  */
 BOOL WINAPI GetPointerDevices(UINT32 *device_count, POINTER_DEVICE_INFO *devices)
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -625,7 +625,7 @@
 @ stdcall GetParent(long)
 @ stdcall GetPhysicalCursorPos(ptr)
 # @ stub GetPointerCursorId
-# @ stub GetPointerDevice
+@ stdcall GetPointerDevice(ptr ptr)
 # @ stub GetPointerDeviceCursors
 # @ stub GetPointerDeviceInputSpace
 # @ stub GetPointerDeviceOrientation
