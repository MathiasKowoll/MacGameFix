+#ifdef __APPLE__
+/* WINE_DIRECT_SYSCALL_DEFERRAL=0 turns finish_direct_syscall and what feeds it off. Rosetta only. */
+static BOOL direct_syscall_deferral;
+
+/***********************************************************************
+ *           finish_direct_syscall
+ *
+ * Under Rosetta 2 the SIGSYS of a syscall instruction does not wait for its turn. When
+ * SIGUSR1 reaches the thread at the same instruction (another thread is suspending it, or
+ * the server has a system APC for it), SIGUSR1's frame is built first, with the thread just
+ * after the instruction and the system call not made. Then one of two things happens to
+ * the SIGSYS:
+ *
+ * - it is delivered on top of that frame, before usr1_handler has run: its context is the
+ *   entry of the signal trampoline, on the signal stack. Sent into the dispatcher, that
+ *   context runs the system call on the signal stack with whatever the registers hold and
+ *   returns into the middle of the trampoline. usr1_handler never runs, so the thread that
+ *   called SuspendThread waits for ever in GetThreadContext, and this one is lost;
+ * - or it is not delivered at all, and the program carries on after its instruction with
+ *   the system call number where the result should be.
+ *
+ * Blocking SIGSYS while other handlers run turns the first into the second: Rosetta drops
+ * a blocked one.
+ *
+ * So sigsys_handler only notes a SIGSYS that lands on the signal stack, and usr1_handler
+ * calls this when it is done, with the context it was given: if a SIGSYS was noted, the
+ * system call is entered from here. rip is where the thread was when the handler began:
+ * a context another thread has moved meanwhile is left alone.
+ *
+ * With no SIGSYS there is only the thread's state to go by, and the two bytes before rip
+ * can end any instruction. The system call is entered if they are 0f 05, rax could be a
+ * system call number, the thread has not been through the dispatcher (which leaves the
+ * return address in rcx, as the instruction does) and r10 equals rcx, as it does after
+ * the mov r10,rcx every system call stub starts with. A program that loads r10 some
+ * other way keeps the second outcome.
+ */
+static void finish_direct_syscall( struct thread_data *data, ucontext_t *sigcontext, ULONG64 rip )
+{
+    struct amd64_thread_data *amd64_data = amd64_thread_data( data );
+    BOOL noted;
+    BYTE insn[2];
+
+    if (!direct_syscall_deferral || !amd64_data) return;
+    noted = amd64_data->direct_syscall_pending;
+    amd64_data->direct_syscall_pending = 0;
+
+    if (RIP_sig(sigcontext) == rip &&
+        (noted ? (WORD)RAX_sig(sigcontext) == amd64_data->direct_syscall_id
+               : (RCX_sig(sigcontext) != rip && RCX_sig(sigcontext) == R10_sig(sigcontext) &&
+                  RAX_sig(sigcontext) < 0x3000)) &&
+        !is_inside_syscall( data, RSP_sig(sigcontext) ) &&
+        !is_inside_signal_stack( data, (void *)RSP_sig(sigcontext) ) &&
+        virtual_uninterrupted_read_memory( (BYTE *)rip - 2, insn, 2 ) == 2 &&
+        insn[0] == 0x0f && insn[1] == 0x05)
+    {
+        TRACE_(seh)( "entering system call %#lx made at %p, %s\n", (long)RAX_sig(sigcontext), (void *)rip,
+                     noted ? "its SIGSYS came on top of this handler" : "its SIGSYS never came" );
+        enter_direct_syscall( data, sigcontext );
+    }
+    else if (noted)
+        ERR_(seh)( "system call %#x not made: SIGSYS came on top of a handler at %p, the thread is at %p\n",
+                   amd64_data->direct_syscall_id, (void *)rip, (void *)RIP_sig(sigcontext) );
+}
+#endif
