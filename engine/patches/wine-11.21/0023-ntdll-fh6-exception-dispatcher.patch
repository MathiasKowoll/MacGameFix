+/* Local, bounded diagnostic. Observes dispatch without changing exception semantics.
+ * No game instruction, exception status or supplied CONTEXT is modified. */
+#if defined(__x86_64__) && !defined(__arm64ec__)
+static LONG observation_enabled = -1;
+static void *observation_sites[32];
+static LONG observation_counts[32];
+static LONG observation_sequence;
+
+static LONG observation_begin(EXCEPTION_RECORD *rec)
+{
+    unsigned i;
+    if (rec->ExceptionCode != STATUS_ILLEGAL_INSTRUCTION &&
+        rec->ExceptionCode != STATUS_PRIVILEGED_INSTRUCTION) return 0;
+    if (observation_enabled == -1)
+    {
+        WCHAR buffer[4];
+        UNICODE_STRING key, value;
+        RtlInitUnicodeString(&key, L"FH6_EXCEPTION_OBSERVE");
+        value.Buffer = buffer; value.Length = 0; value.MaximumLength = sizeof(buffer);
+        InterlockedCompareExchange(&observation_enabled,
+            !RtlQueryEnvironmentVariable_U(NULL, &key, &value) &&
+            value.Length == sizeof(WCHAR) && buffer[0] == '1', -1);
+    }
+    if (!observation_enabled) return 0;
+    /* Follow-up is restricted to the seven sites from the prior exception-frequency capture. */
+    {
+        static const ULONG_PTR selected[] = {0x4941fe0,0x494220c,0x44d85ad,0x44d7ff0,0x44d518c,0x44d5090,0x44d7870};
+        ULONG_PTR rva = (ULONG_PTR)rec->ExceptionAddress - (ULONG_PTR)NtCurrentTeb()->Peb->ImageBaseAddress;
+        for (i=0; i<ARRAY_SIZE(selected); ++i) if (rva == selected[i]) break;
+        if (i == ARRAY_SIZE(selected)) return 0;
+    }
+
+    /* Delay this final capture to separate startup work from the later steady workload. */
+    {
+        static LONGLONG first_tick;
+        LARGE_INTEGER tick, frequency;
+        NtQueryPerformanceCounter(&tick, &frequency);
+        InterlockedCompareExchange64(&first_tick, tick.QuadPart, 0);
+        if (tick.QuadPart - first_tick < 100 * frequency.QuadPart) return 0;
+    }
+    for (i = 0; i < ARRAY_SIZE(observation_sites); ++i)
+    {
+        void *previous = InterlockedCompareExchangePointer(&observation_sites[i], rec->ExceptionAddress, NULL);
+        if (!previous || previous == rec->ExceptionAddress)
+            return InterlockedIncrement(&observation_counts[i]) <= 4 ?
+                   InterlockedIncrement(&observation_sequence) : 0;
+    }
+    return 0;
+}
+
+static void observation_code(LONG id, const char *phase, ULONG_PTR address)
+{
+    BYTE bytes[16]; SIZE_T got = 0; unsigned i;
+    char hex[33]; static const char digits[] = "0123456789abcdef";
+    NTSTATUS status = NtReadVirtualMemory(GetCurrentProcess(), (void *)address, bytes, sizeof(bytes), &got);
+    for (i = 0; i < got && i < sizeof(bytes); ++i)
+    { hex[2*i] = digits[bytes[i] >> 4]; hex[2*i+1] = digits[bytes[i] & 15]; }
+    hex[2*i] = 0;
+    MESSAGE("EXOBS id=%ld phase=%s address=%p status=%08lx bytes=%s\n", id, phase, (void *)address, status, hex);
+}
+
+static void observation_context(LONG id, const char *phase, const CONTEXT *ctx, const CONTEXT *before)
+{
+#define OBS_REG(reg) if (!before || ctx->reg != before->reg) \
+    MESSAGE("EXOBS id=%ld phase=%s reg=" #reg " value=%016I64x\n", id, phase, (ULONGLONG)ctx->reg)
+    unsigned i;
+    OBS_REG(Rip); OBS_REG(Rsp); OBS_REG(Rax); OBS_REG(Rbx); OBS_REG(Rcx); OBS_REG(Rdx);
+    OBS_REG(Rsi); OBS_REG(Rdi); OBS_REG(Rbp); OBS_REG(R8); OBS_REG(R9); OBS_REG(R10);
+    OBS_REG(R11); OBS_REG(R12); OBS_REG(R13); OBS_REG(R14); OBS_REG(R15);
+    OBS_REG(EFlags); OBS_REG(MxCsr); OBS_REG(ContextFlags);
+    for (i=0; i<16; ++i)
+    {
+        const M128A *v = &ctx->FltSave.XmmRegisters[i];
+        const M128A *b = before ? &before->FltSave.XmmRegisters[i] : NULL;
+        if (!b || v->Low != b->Low || v->High != b->High)
+            MESSAGE("EXOBS id=%ld phase=%s xmm=%u value=%016I64x%016I64x\n", id, phase, i, (ULONGLONG)v->High, v->Low);
+    }
+#undef OBS_REG
+}
+#else
+static LONG observation_begin(EXCEPTION_RECORD *rec) { return 0; }
+#endif
