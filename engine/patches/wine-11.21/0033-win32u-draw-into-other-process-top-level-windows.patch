+
+struct foreign_surface
+{
+    struct list entry;
+    HWND hwnd;
+    struct window_surface *surface;
+};
+static struct list foreign_surfaces = LIST_INIT( foreign_surfaces );
+
+static void release_foreign_surface( struct foreign_surface *foreign )
+{
+    list_remove( &foreign->entry );
+    window_surface_release( foreign->surface );
+    free( foreign );
+}
+
+static struct window_surface *get_foreign_window_surface( HWND hwnd, const RECT *top_rect )
+{
+    struct foreign_surface *foreign, *next, *found = NULL;
+    struct window_surface *surface = NULL;
+    RECT rect = *top_rect;
+
+    if (IsRectEmpty( &rect )) return NULL;
+    OffsetRect( &rect, -rect.left, -rect.top );
+
+    user_lock();
+    LIST_FOR_EACH_ENTRY_SAFE( foreign, next, &foreign_surfaces, struct foreign_surface, entry )
+    {
+        if (foreign->hwnd == hwnd) found = foreign;
+        else if (!is_window( foreign->hwnd )) release_foreign_surface( foreign );
+    }
+    if (found && !EqualRect( &found->surface->rect, &rect ))
+    {
+        release_foreign_surface( found );
+        found = NULL;
+    }
+    if (!found && (surface = create_shm_surface( hwnd, hwnd, top_rect, NULL )))
+    {
+        get_shm_surface( surface )->toplevel = TRUE;
+        if ((found = malloc( sizeof(*found) )))
+        {
+            found->hwnd = hwnd;
+            found->surface = surface;
+            list_add_tail( &foreign_surfaces, &found->entry );
+        }
+        else window_surface_release( surface );
+    }
+    if (found) window_surface_add_ref( (surface = found->surface) );
+    else surface = NULL;
+    user_unlock();
+    return surface;
+}
+
+static void flush_foreign_window_surfaces(void)
+{
+    struct window_surface *surfaces[16];
+    struct foreign_surface *foreign;
+    UINT i, count = 0;
+
+    user_lock();
+    LIST_FOR_EACH_ENTRY( foreign, &foreign_surfaces, struct foreign_surface, entry )
+    {
+        if (count == ARRAY_SIZE(surfaces)) break;
+        window_surface_add_ref( (surfaces[count++] = foreign->surface) );
+    }
+    user_unlock();
+    for (i = 0; i < count; i++)
+    {
+        window_surface_flush( surfaces[i] );
+        window_surface_release( surfaces[i] );
+    }
 }
 
