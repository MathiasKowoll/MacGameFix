+/* With diagnostics=on, every 2 s: how many input reports the pad sent and the
+ * longest gap between two, as they reach winebus, which is the most a game can
+ * read of the pad. On a cable and over Bluetooth alike, for comparing the two
+ * and Game Mode on and off. */
+static void pad_input_rate(struct iohid_device *impl)
+{
+    UInt64 now = mach_absolute_time();
+    unsigned int gap;
+
+    if (!impl->input_diagnostics) return;
+    if (impl->input_last && now - impl->input_last > impl->input_gap) impl->input_gap = now - impl->input_last;
+    impl->input_last = now;
+    impl->input_count++;
+    if (!impl->input_since) impl->input_since = now;
+    if (now - impl->input_since < bt_ticks(2.0)) return;
+    gap = (unsigned int)(impl->input_gap * bt_timebase.numer / bt_timebase.denom / 100000);
+    pad_log("the %s %s sent %u input reports in 2 s, %u a second; the longest gap between two was %u.%u ms\n",
+            impl->bt ? "Bluetooth" : "wired", impl->model, impl->input_count,
+            (unsigned int)(impl->input_count * 1e9 / ((now - impl->input_since) * bt_timebase.numer / bt_timebase.denom)),
+            gap / 10, gap % 10);
+    impl->input_since = now;
+    impl->input_count = 0;
+    impl->input_gap = 0;
+}
+
+/* With diagnostics=on: each time the game's motor values rise to 4 or more (what
+ * rumble=haptics plays and the motors' own deadband lets through) and each time
+ * they fall back, with how long they stayed up, the strongest and the last
+ * values, heavy then light. A game that never lets them fall shows it here. */
+static void pad_motors_told(struct iohid_device *impl, BYTE heavy, BYTE light)
+{
+    UInt64 now = mach_absolute_time();
+    BOOL on = heavy >= 4 || light >= 4;
+
+    if (!impl->input_diagnostics) return;
+    if (!bt_timebase.denom) mach_timebase_info(&bt_timebase);
+    if (on && !impl->motors_on)
+    {
+        impl->motors_on = TRUE;
+        impl->motors_since = now;
+        impl->motors_peak[0] = heavy;
+        impl->motors_peak[1] = light;
+        pad_log("the game's motors rise: heavy 0x%02x, light 0x%02x\n", heavy, light);
+    }
+    else if (on)
+    {
+        impl->motors_peak[0] = max(impl->motors_peak[0], heavy);
+        impl->motors_peak[1] = max(impl->motors_peak[1], light);
+    }
+    else if (impl->motors_on)
+    {
+        impl->motors_on = FALSE;
+        pad_log("the game's motors fall after %u ms: the strongest heavy 0x%02x, light 0x%02x; the last before 0x%02x, 0x%02x\n",
+                (unsigned int)((now - impl->motors_since) * bt_timebase.numer / bt_timebase.denom / 1000000),
+                impl->motors_peak[0], impl->motors_peak[1], impl->motors_last[0], impl->motors_last[1]);
+    }
+    if (on)
+    {
+        impl->motors_last[0] = heavy;
+        impl->motors_last[1] = light;
+    }
+}
