+static void *bt_receiver(void *arg)
+{
+    struct bt_pad *pad = arg;
+    struct { char magic[4]; signed char samples[2 * 256]; } packet;
+    ssize_t got;
+    unsigned int i, n;
+    BOOL nonzero;
+
+    while (!pad->quit)
+    {
+        if ((got = recv(pad->sock, &packet, sizeof(packet), 0)) < 6 || memcmp(packet.magic, "MGFH", 4)) continue;
+        n = (got - 4) / 2;
+        nonzero = FALSE;
+        pthread_mutex_lock(&pad->lock);
+        for (i = 0; i < n; i++)
+        {
+            if (pad->fifo_count == ARRAY_SIZE(pad->fifo))
+            {
+                pad->fifo_head = (pad->fifo_head + 1) % ARRAY_SIZE(pad->fifo);
+                pad->fifo_count--;
+            }
+            memcpy(pad->fifo[(pad->fifo_head + pad->fifo_count++) % ARRAY_SIZE(pad->fifo)], packet.samples + 2 * i, 2);
+            nonzero |= packet.samples[2 * i] || packet.samples[2 * i + 1];
+        }
+        pad->audio_at = mach_absolute_time();
+        if (nonzero) pad->nonzero_at = pad->audio_at;
+        pthread_mutex_unlock(&pad->lock);
+        semaphore_signal(pad->wake);
+    }
+    return NULL;
+}
+
+/* The pad's one writer. Haptics stream while the game plays something on
+ * channels 3 and 4, and for 150 ms after; the game's output goes out at most
+ * every 16 ms, or while haptics stream, in the link's remaining ~18 reports a
+ * second. It writes nothing while the pad sends no input: the link is gone. */
+static void *bt_writer(void *arg)
+{
+    struct bt_pad *pad = arg;
+    const double pcm_period = 64.0 / 3000, streaming_gap = 1.0 / (65 - 3000.0 / 64);
+    thread_time_constraint_policy_data_t policy;
+    BYTE payload[47];
+    signed char samples[128];
+    BOOL streaming = FALSE, audio, control;
+    unsigned int index = 0, i, n;
+    UInt64 now, next_pcm = 0, next_control = 0, wake_at;
+
+    policy.period = (uint32_t)bt_ticks(pcm_period);
+    policy.computation = (uint32_t)bt_ticks(0.001);
+    policy.constraint = (uint32_t)bt_ticks(0.005);
+    policy.preemptible = TRUE;
+    thread_policy_set(pthread_mach_thread_np(pthread_self()), THREAD_TIME_CONSTRAINT_POLICY,
+                      (thread_policy_t)&policy, THREAD_TIME_CONSTRAINT_POLICY_COUNT);
+
+    while (!pad->quit)
+    {
+        now = mach_absolute_time();
+        pthread_mutex_lock(&pad->lock);
+        if (now - pad->input_at > bt_ticks(0.5))
+        {
+            pthread_mutex_unlock(&pad->lock);
+            streaming = FALSE;
+            bt_wait_until(pad, now + bt_ticks(0.020));
+            continue;
+        }
+        audio = pad->nonzero_at && now - pad->nonzero_at < bt_ticks(0.15) &&
+                (pad->fifo_count || now - pad->audio_at < bt_ticks(0.15));
+        if (!audio && !streaming) pad->fifo_head = pad->fifo_count = 0;
+        if ((control = pad->dirty && now >= next_control))
+        {
+            memcpy(payload, pad->pending, sizeof(payload));
+            pad->dirty = FALSE;
+        }
+        pthread_mutex_unlock(&pad->lock);
+
+        if (control)
+        {
+            bt_control(pad, payload, audio || streaming);
+            next_control = mach_absolute_time() + bt_ticks(audio || streaming ? streaming_gap : 0.016);
+        }
+        if (audio && !streaming)
+        {
+            bt_control(pad, NULL, TRUE);
+            streaming = TRUE;
+            index = 0;
+            next_pcm = mach_absolute_time() + bt_ticks(0.030);
+        }
+        if (streaming && mach_absolute_time() >= next_pcm)
+        {
+            /* After a stall, start the clock again rather than send a burst. */
+            if (mach_absolute_time() > next_pcm + bt_ticks(0.040)) next_pcm = mach_absolute_time();
+            memset(samples, 0, sizeof(samples));
+            pthread_mutex_lock(&pad->lock);
+            n = min(pad->fifo_count, 64);
+            for (i = 0; i < n; i++)
+            {
+                memcpy(samples + 2 * i, pad->fifo[pad->fifo_head], 2);
+                pad->fifo_head = (pad->fifo_head + 1) % ARRAY_SIZE(pad->fifo);
+                pad->fifo_count--;
+            }
+            pthread_mutex_unlock(&pad->lock);
+            bt_pcm(pad, index++, samples);
+            next_pcm += bt_ticks(pcm_period);
+            if (!audio)
+            {
+                /* Let the silent tail reach the actuators, then rumble again. */
+                mach_wait_until(mach_absolute_time() + bt_ticks(0.030));
+                pthread_mutex_lock(&pad->lock);
+                memcpy(payload, pad->pending, sizeof(payload));
+                pthread_mutex_unlock(&pad->lock);
+                bt_control(pad, payload, FALSE);
+                streaming = FALSE;
+            }
+        }
+
+        now = mach_absolute_time();
+        wake_at = now + bt_ticks(0.050);
+        if (streaming && next_pcm < wake_at) wake_at = next_pcm;
+        pthread_mutex_lock(&pad->lock);
+        if (pad->dirty && next_control < wake_at) wake_at = next_control;
+        pthread_mutex_unlock(&pad->lock);
+        /* The haptics' deadline is kept to the tick; anything else may wake it early. */
+        if (streaming && wake_at == next_pcm) mach_wait_until(wake_at);
+        else bt_wait_until(pad, wake_at);
+    }
+    return NULL;
+}
+
+static void bt_queue_output(struct bt_pad *pad, const BYTE *usb)
+{
+    const BYTE *update = usb + 1;
+    BYTE merged[47];
+    unsigned int i;
+
+    pthread_mutex_lock(&pad->lock);
+    memcpy(merged, update, sizeof(merged));
+    if (pad->dirty)
+    {
+        for (i = 0; i < ARRAY_SIZE(bt_fields); i++)
+        {
+            BYTE flag = bt_fields[i].flag, mask = bt_fields[i].mask & pad->pending[flag] & ~update[flag];
+            if (!mask) continue;
+            merged[flag] |= mask;
+            memcpy(merged + bt_fields[i].offset, pad->pending + bt_fields[i].offset, bt_fields[i].length);
+        }
+    }
+    if (update[0] & 3)
+    {
+        pad->motors[0] = update[2];
+        pad->motors[1] = update[3];
+    }
+    memcpy(pad->pending, merged, sizeof(merged));
+    pad->dirty = TRUE;
+    pthread_mutex_unlock(&pad->lock);
+    semaphore_signal(pad->wake);
+}
+
+static struct bt_pad *bt_pad_create(IOHIDDeviceRef device, DWORD pid, DWORD location, BOOL physical_edge)
+{
+    struct bt_pad *pad;
+
+    if (!(pad = calloc(1, sizeof(*pad)))) return NULL;
+    pad->device = device;
+    pad->edge = pid == DS_EDGE_PID;
+    pad->physical_edge = physical_edge;
+    pad->location = location;
+    pad->sock = -1;
+    pthread_mutex_init(&pad->lock, NULL);
+    if (semaphore_create(mach_task_self(), &pad->wake, SYNC_POLICY_FIFO, 0))
+    {
+        free(pad);
+        return NULL;
+    }
+    return pad;
+}
+
+/* The socket winecoreaudio.so finds the pad by: /tmp/macgamefix-<uid>/
+ * pad-<location>-<product shown>-<product it is>.sock. */
+static void bt_pad_listen(struct bt_pad *pad)
+{
+    struct sockaddr_un addr = {.sun_family = AF_UNIX};
+    struct timeval timeout = {0, 200000};
+    char dir[64];
+
+    snprintf(dir, sizeof(dir), "/tmp/macgamefix-%u", (unsigned int)getuid());
+    mkdir(dir, 0700);
+    snprintf(pad->path, sizeof(pad->path), "%s/pad-%08x-%04x-%04x.sock", dir, (unsigned int)pad->location,
+             pad->edge ? DS_EDGE_PID : DUALSENSE_PID, pad->physical_edge ? DS_EDGE_PID : DUALSENSE_PID);
+    if ((pad->sock = socket(AF_UNIX, SOCK_DGRAM, 0)) < 0) return;
+    unlink(pad->path);
+    snprintf(addr.sun_path, sizeof(addr.sun_path), "%s", pad->path);
+    if (bind(pad->sock, (struct sockaddr *)&addr, sizeof(addr)))
+    {
+        WARN("cannot listen for the DualSense's haptics at %s\n", pad->path);
+        close(pad->sock);
+        pad->sock = -1;
+        return;
+    }
+    setsockopt(pad->sock, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+}
+
+static void bt_pad_start(struct bt_pad *pad)
+{
+    BYTE calibration[64] = {0x05};
+    CFIndex length = 41;
+
+    /* Reading the calibration switches the pad from its short Bluetooth
+     * report to the full 0x31 one, as Linux's driver does. */
+    IOHIDDeviceGetReport(pad->device, kIOHIDReportTypeFeature, 0x05, calibration, &length);
+    pad->input_at = mach_absolute_time();
+    pad->quit = FALSE;
+    bt_pad_listen(pad);
+    pad->running = !pthread_create(&pad->writer, NULL, bt_writer, pad);
+    if (pad->running && pad->sock >= 0 && pthread_create(&pad->receiver, NULL, bt_receiver, pad))
+    {
+        close(pad->sock);
+        pad->sock = -1;
+    }
+}
+
+static void bt_pad_stop(struct bt_pad *pad)
+{
+    if (!pad->running) return;
+    pad->quit = TRUE;
+    semaphore_signal(pad->wake);
+    pthread_join(pad->writer, NULL);
+    if (pad->sock >= 0)
+    {
+        pthread_join(pad->receiver, NULL);
+        close(pad->sock);
+        unlink(pad->path);
+        pad->sock = -1;
+    }
+    pad->running = FALSE;
+}
