+static void pad_game(char *id, size_t size);
+
+/* What this file has to say goes to /tmp/macgamefix-<uid>/pad.log, beside the
+ * pads' sockets: a game's own stderr often reaches no log at all. Each line
+ * names the game, which MacGameFix reads back for what it learns of each one. */
+static void pad_log(const char *format, ...) __attribute__((format(printf, 1, 2)));
+static void pad_log(const char *format, ...)
+{
+    char path[64], stamp[32], game[24];
+    struct tm tm;
+    time_t now = time(NULL);
+    va_list args;
+    FILE *f;
+
+    snprintf(path, sizeof(path), "/tmp/macgamefix-%u", (unsigned int)getuid());
+    mkdir(path, 0700);
+    snprintf(path + strlen(path), sizeof(path) - strlen(path), "/pad.log");
+    if (!(f = fopen(path, "a"))) return;
+    localtime_r(&now, &tm);
+    strftime(stamp, sizeof(stamp), "%H:%M:%S", &tm);
+    pad_game(game, sizeof(game));
+    fprintf(f, "%s [%d] game=%s ", stamp, (int)getpid(), game[0] ? game : "-");
+    va_start(args, format);
+    vfprintf(f, format, args);
+    va_end(args);
+    fclose(f);
+}
+
+/* The game this process runs for: the Steam app id Steam and NotProton give a
+ * game (SteamAppId, SteamGameId, STEAM_COMPAT_APP_ID), else the one in a Steam
+ * Play prefix's path, compatdata/<id>/pfx. Empty in a CrossOver bottle. */
+static void pad_game(char *id, size_t size)
+{
+    static const char *const names[] = {"SteamAppId", "SteamGameId", "STEAM_COMPAT_APP_ID"};
+    const char *v;
+    size_t n;
+    unsigned int i;
+
+    id[0] = 0;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        if (!(v = getenv(names[i])) || !*v || strspn(v, "0123456789") != strlen(v) || !strcmp(v, "0")) continue;
+        snprintf(id, size, "%s", v);
+        return;
+    }
+    if ((v = getenv("WINEPREFIX")) && (v = strstr(v, "/compatdata/")))
+    {
+        v += strlen("/compatdata/");
+        n = strspn(v, "0123456789");
+        if (n && n < size && !strncmp(v + n, "/pfx", 4)) snprintf(id, size, "%.*s", (int)n, v);
+    }
+}
+
+/* MacGameFix's settings for the pad, which its Game Feel tab writes, read
+ * once: ~/Library/Application Support/MacGameFix/pad.d/<app id>.conf for this
+ * game, then pad.conf for every game; the first line with a key wins. A line
+ * is key=value: "bluetooth=wired"; "motor_power=full", the motor power claimed
+ * at 0x00 for an Edge as Sony's library claims it for a standard pad (see
+ * iohid_device_set_output_report); "edge=dualsense", a Bluetooth Edge shown to
+ * games as the standard pad; "diagnostics=on", which adds what a game writes
+ * to the pad and reads from it to pad.log. */
+static const char *pad_value(const char *key)
+{
+    static char lines[32][96];
+    static int count = -1;
+    char path[1024], line[128], game[24];
+    const char *home;
+    size_t n, length = strlen(key);
+    BOOL from_game = FALSE;
+    FILE *f;
+    int i, pass;
+
+    if (count < 0)
+    {
+        count = 0;
+        pad_game(game, sizeof(game));
+        if ((home = getenv("HOME")))
+        {
+            for (pass = 0; pass < 2; pass++)
+            {
+                if (pass == 0 && !game[0]) continue;
+                if (pass == 0)
+                    snprintf(path, sizeof(path), "%s/Library/Application Support/MacGameFix/pad.d/%s.conf", home, game);
+                else
+                    snprintf(path, sizeof(path), "%s/Library/Application Support/MacGameFix/pad.conf", home);
+                if (!(f = fopen(path, "r"))) continue;
+                if (pass == 0) from_game = TRUE;
+                while (count < 32 && fgets(line, sizeof(line), f))
+                {
+                    n = strcspn(line, "\r\n");
+                    line[n] = 0;
+                    if (n) snprintf(lines[count++], sizeof(lines[0]), "%s", line);
+                }
+                fclose(f);
+            }
+        }
+        pad_log("settings: %s%s\n", game[0] ? "game " : "no game id, ", game[0] ? game : "every game's");
+        if (from_game) pad_log("settings: pad.d/%s.conf read before pad.conf\n", game);
+    }
+    for (i = 0; i < count; i++)
+        if (!strncmp(lines[i], key, length) && lines[i][length] == '=') return lines[i] + length + 1;
+    return "";
+}
+
+/* Whether a setting is "key=value". */
+static BOOL pad_option(const char *option)
+{
+    const char *eq = strchr(option, '=');
+    char key[32];
+
+    if (!eq || eq - option >= (int)sizeof(key)) return FALSE;
+    snprintf(key, sizeof(key), "%.*s", (int)(eq - option), option);
+    return !strcmp(pad_value(key), eq + 1);
+}
+
+static BOOL bluetooth_as_wired(void)
+{
+    return pad_option("bluetooth=wired");
+}
+
+/* Says a value once per device: bit i of the set is value i. */
+static BOOL first_time(UINT32 set[8], BYTE value)
+{
+    UINT32 bit = 1u << (value & 31);
+    if (set[value >> 5] & bit) return FALSE;
+    set[value >> 5] |= bit;
+    return TRUE;
+}
+
+static BOOL is_bluetooth_dualsense(IOHIDDeviceRef device, DWORD vid, DWORD pid)
+{
+    CFStringRef str = IOHIDDeviceGetProperty(device, CFSTR(kIOHIDTransportKey));
+
+    if (vid != SONY_VID || (pid != DUALSENSE_PID && pid != DS_EDGE_PID)) return FALSE;
+    if (!str || CFGetTypeID(str) != CFStringGetTypeID()) return FALSE;
+    if (CFStringCompare(str, CFSTR(kIOHIDTransportBluetoothValue), 0) &&
+        CFStringCompare(str, CFSTR(kIOHIDTransportBluetoothLowEnergyValue), 0)) return FALSE;
+    return bluetooth_as_wired();
+}
+
+static UINT32 bt_crc32(BYTE seed, const BYTE *data, size_t length)
+{
+    UINT32 crc = ~0u;
+    size_t i;
+    int bit;
+
+    crc ^= seed;
+    for (bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ (0xedb88320u & -(crc & 1));
+    for (i = 0; i < length; i++)
+    {
+        crc ^= data[i];
+        for (bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ (0xedb88320u & -(crc & 1));
+    }
+    return ~crc;
+}
+
+/* Fields a game sets with a valid flag: one report merged over another keeps
+ * an earlier field the later one did not set. Anything else is the later
+ * report's. Offsets count from the byte after the report ID. */
+static const struct { BYTE flag, mask, offset, length; } bt_fields[] =
+{
+    {0, 0x03,  2,  2},  /* rumble motors */
+    {0, 0x04, 10, 11},  /* right trigger effect */
+    {0, 0x08, 21, 11},  /* left trigger effect */
+    {1, 0x01,  8,  1},  /* microphone LED */
+    {1, 0x04, 44,  3},  /* lightbar colour */
+    {1, 0x10, 43,  1},  /* player LEDs */
+    {1, 0x40, 36,  1},  /* motor power */
 };
 
+static mach_timebase_info_data_t bt_timebase;
+
+static UInt64 bt_ticks(double seconds)
+{
+    if (!bt_timebase.denom) mach_timebase_info(&bt_timebase);
+    return (UInt64)(seconds * 1e9 * bt_timebase.denom / bt_timebase.numer);
+}
+
+/* Waits for new output or haptics, or until the deadline. */
+static void bt_wait_until(struct bt_pad *pad, UInt64 deadline)
+{
+    UInt64 now = mach_absolute_time(), nanos;
+
+    if (deadline <= now) return;
+    if (!bt_timebase.denom) mach_timebase_info(&bt_timebase);
+    nanos = (deadline - now) * bt_timebase.numer / bt_timebase.denom;
+    semaphore_timedwait(pad->wake, (mach_timespec_t){(unsigned int)(nanos / 1000000000), (clock_res_t)(nanos % 1000000000)});
+}
+
+static BOOL bt_write(struct bt_pad *pad, BYTE *report, UINT size)
+{
+    UINT32 crc = bt_crc32(0xa2, report, size - 4);
+    int i;
+
+    for (i = 0; i < 4; i++) report[size - 4 + i] = crc >> (8 * i);
+    if (!IOHIDDeviceSetReport(pad->device, kIOHIDReportTypeOutput, report[0], report, size)) return TRUE;
+    WARN("Bluetooth output 0x%02x to the DualSense failed\n", report[0]);
+    return FALSE;
+}
+
+/* Report 0x31. In audio mode the rumble bits are the writer's to clear, so that
+ * a game's rumble or reset command cannot stop the haptics; out of it the pad
+ * rumbles with the game's last motor values. */
+static void bt_control(struct bt_pad *pad, const BYTE *payload, BOOL audio)
+{
+    BYTE report[78] = {0x31};
+
+    report[1] = (pad->seq++ & 15) << 4;
+    report[2] = 0x10;
+    if (payload) memcpy(report + 3, payload, 47);
+    if (pad_option("motor_power=full"))
+    {
+        report[4] |= 0x40;
+        report[39] = 0;
+    }
+    if (audio)
+    {
+        report[3] &= ~3;
+        report[5] = report[6] = 0;
+    }
+    else
+    {
+        report[3] |= 3;
+        report[5] = pad->motors[0];
+        report[6] = pad->motors[1];
+    }
+    report[41] &= ~4;
+    bt_write(pad, report, sizeof(report));
+}
+
+/* Reports 0x33 (the first, which sets the pad's audio up) and 0x32: 64 frames
+ * of 3 kHz signed 8-bit stereo. */
+static void bt_pcm(struct bt_pad *pad, unsigned int index, const signed char samples[128])
+{
+    BYTE report[206] = {0};
+    UINT size, offset;
+
+    report[0] = index ? 0x32 : 0x33;
+    report[1] = (pad->seq++ & 15) << 4;
+    report[2] = 0x91;
+    if (!index)
+    {
+        report[3] = 7;
+        report[4] = 0xfe;
+        memset(report + 5, 48, 5);
+        report[10] = index * 2;
+        report[11] = 0xd2;
+        report[12] = 64;
+        offset = 13;
+        size = 206;
+    }
+    else
+    {
+        report[3] = 3;
+        report[4] = 0x62;
+        report[5] = 48;
+        report[6] = (BYTE)(index * 2);
+        report[7] = 0xd2;
+        report[8] = 64;
+        offset = 9;
+        size = 142;
+    }
+    memcpy(report + offset, samples, 128);
+    bt_write(pad, report, size);
+}
