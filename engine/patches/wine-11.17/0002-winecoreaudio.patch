+
+/* Apple's USB audio driver puts the device's location ID in the endpoint's UID:
+ * "AppleUSBAudioEngine:<manufacturer>:<product>:<location ID in hex>:<interface>".
+ * winebus.sys builds the same container from that location ID for the device's HID
+ * functions, so that games can pair a controller with its audio output; keep the
+ * two in sync. */
+static BOOL get_usb_container_id(const char *device, GUID *guid)
+{
+    static const GUID usb_location_base = {0, 0x27f2, 0x4948, {0x96, 0x54, 0x15, 0x28, 0x04, 0xaf, 0x63, 0x78}};
+    static const char prefix[] = "AppleUSBAudioEngine:";
+    const char *start, *end;
+    unsigned long location;
+    char *parsed;
+
+    if(strncmp(device, prefix, strlen(prefix)) || !(end = strrchr(device, ':')))
+        return FALSE;
+    for(start = end; start > device && start[-1] != ':'; start--);
+    location = strtoul(start, &parsed, 16);
+    if(parsed != end || !location || location > 0xffffffff)
+        return FALSE;
+
+    *guid = usb_location_base;
+    guid->Data1 = location;
+    return TRUE;
 }
 
