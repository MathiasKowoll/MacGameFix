+/* Game Feel's settings as they are now: read again into a copy, then put in
+ * place, so a reader on another thread sees the old lines or the new ones. */
+static void pad_reload(void)
+{
+    static char lines[32][96];
+    int count, game_count;
+    BOOL from_game;
+    char game[24];
+
+    count = pad_load(lines, &game_count, &from_game, game);
+    pad_count = min(pad_count, count);
+    memcpy(pad_lines, lines, sizeof(lines));
+    pad_game_count = game_count;
+    pad_count = count;
+}
