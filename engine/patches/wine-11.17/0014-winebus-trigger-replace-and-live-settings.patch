+/* Game Feel written while the game runs: once a second the two files are
+ * looked at, and when they changed the chosen effects are read again and put
+ * on the pad, releasing a side whose effect was ours and has none now. A side
+ * the game had taken follows the new choice until the game sets one again.
+ * The other settings read on each report (motor_power, for one) follow by
+ * themselves once the lines are read again; the ones that shape the device,
+ * xinput, pad_as, bluetooth, wait for the next start. */
+static void pad_settings_follow(struct iohid_device *impl)
+{
+    static const char *const keys[2] = {"trigger_r2", "trigger_l2"};
+    static const char *const keys2[2] = {"trigger_r2_with_l2", "trigger_l2_with_r2"};
+    BYTE report[64] = {0x02};
+    UInt64 now = mach_absolute_time();
+    unsigned int side, set = 0;
+    long long stamp;
+    BOOL ours;
+    char path[64];
+    FILE *f;
+
+    if (!impl->settings_checked || now - impl->settings_checked < bt_ticks(1.0)) return;
+    impl->settings_checked = now;
+    if ((stamp = pad_settings_stamp()) == impl->settings_stamp) return;
+    impl->settings_stamp = stamp;
+    pad_reload();
+    for (side = 0; side < 2; side++)
+    {
+        ours = trigger_chosen(impl, side) && !impl->trigger_game[side] && impl->trigger_kind[side] != TRIGGER_OFF;
+        pad_trigger_choice(keys[side], &impl->trigger_kind[side], &impl->trigger_strength[side]);
+        pad_trigger_choice(keys2[side], &impl->trigger_kind2[side], &impl->trigger_strength2[side]);
+        impl->trigger_replace[side] = !strcmp(pad_value(side ? "trigger_l2_replace" : "trigger_r2_replace"), "on");
+        impl->trigger_game[side] = impl->trigger_following[side] = impl->trigger_game_on[side] = FALSE;
+        impl->trigger_held[side] = FALSE;
+        impl->trigger_step[side] = 0;
+        if (trigger_chosen(impl, side)) set |= 4 << side;
+        if (trigger_chosen(impl, side) && impl->trigger_kind[side] != TRIGGER_OFF)
+        {
+            report[1] |= 4 << side;
+            trigger_effect(impl->trigger_kind[side], impl->trigger_strength[side], 0, report + 11 + 11 * side);
+        }
+        else if (ours)
+        {
+            report[1] |= 4 << side;
+            report[11 + 11 * side] = 0x05;
+        }
+    }
+    if (report[1]) pad_write_output(impl, report);
+    trigger_marker(impl, path, sizeof(path));
+    if (!set) unlink(path);
+    else if ((f = fopen(path, "w")))
+    {
+        fprintf(f, "%u\n", set);
+        fclose(f);
+    }
+    pad_log("settings changed while the game runs: R2 %s%s, L2 %s%s\n",
+            pad_value("trigger_r2")[0] ? pad_value("trigger_r2") : "off", impl->trigger_replace[0] ? " in place of the game's" : "",
+            pad_value("trigger_l2")[0] ? pad_value("trigger_l2") : "off", impl->trigger_replace[1] ? " in place of the game's" : "");
 }
 
