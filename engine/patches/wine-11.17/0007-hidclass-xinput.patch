+/* MacGameFix: does this collection carry a HID haptics controller? Wine's xinput
+ * drives a pad's motors through one and through nothing else, so this is the
+ * question "can xinput rumble it", asked of the descriptor. */
+static BOOL has_haptics_collection( HIDP_COLLECTION_DESC *desc )
+{
+    HIDP_LINK_COLLECTION_NODE *nodes;
+    ULONG count, i;
+    BOOL found = FALSE;
+    HIDP_CAPS caps;
+
+    if (HidP_GetCaps( desc->PreparsedData, &caps ) != HIDP_STATUS_SUCCESS) return FALSE;
+    if (!(count = caps.NumberLinkCollectionNodes)) return FALSE;
+    if (!(nodes = malloc( count * sizeof(*nodes) ))) return FALSE;
+    if (HidP_GetLinkCollectionNodes( nodes, &count, desc->PreparsedData ) == HIDP_STATUS_SUCCESS)
+        for (i = 0; i < count && !found; i++)
+            found = nodes[i].LinkUsagePage == HID_USAGE_PAGE_HAPTICS &&
+                    nodes[i].LinkUsage == HID_USAGE_HAPTICS_SIMPLE_CONTROLLER;
+    free( nodes );
+    return found;
+}
+
+/* MacGameFix: a collection that exists only to carry motors, as winebus adds to
+ * a DualSense for xinput (patch 0006): a multi-axis controller, with a haptics
+ * collection and no axis on the generic desktop page. A real pad, wheel or
+ * joystick declares a gamepad or a joystick, or has axes, and stays a HID
+ * device whatever else it carries. */
+static BOOL is_motors_only_collection( HIDP_COLLECTION_DESC *desc )
+{
+    HIDP_VALUE_CAPS *values;
+    BOOL axes = FALSE;
+    HIDP_CAPS caps;
+    USHORT count;
+    ULONG i;
+
+    if (desc->UsagePage != HID_USAGE_PAGE_GENERIC || desc->Usage != HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER) return FALSE;
+    if (!has_haptics_collection( desc )) return FALSE;
+    if (HidP_GetCaps( desc->PreparsedData, &caps ) != HIDP_STATUS_SUCCESS) return FALSE;
+    if (!(count = caps.NumberInputValueCaps)) return TRUE;
+    if (!(values = malloc( count * sizeof(*values) ))) return FALSE;
+    if (HidP_GetValueCaps( HidP_Input, values, &count, desc->PreparsedData ) == HIDP_STATUS_SUCCESS)
+        for (i = 0; i < count && !axes; i++) axes = values[i].UsagePage == HID_USAGE_PAGE_GENERIC;
+    free( values );
+    return !axes;
+}
