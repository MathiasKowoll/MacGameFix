+/***********************************************************************
+ *           rosetta_extend_cpuid
+ *
+ * HRAVA_ROSETTA_CPUID: Rosetta 2 reports CPUID leaf 7 as EBX 0x128 (BMI1, AVX2, BMI2) and
+ * ECX 0, the feature level of a 2013 CPU. Programs built for the Skylake/Zen level check
+ * for more and refuse to continue; copy protection built for that level compares the
+ * leaf with what the instructions actually do and falls into an endless fault instead of
+ * saying so (STAR WARS: Galactic Racer, 2026).
+ *
+ * Three of the missing features are really there: Rosetta executes CLFLUSHOPT, and this
+ * file emulates CLWB and RDPID. The Rosetta runtime keeps its CPUID leaves as a table of
+ * {eax, ebx, ecx, edx} rows in its own read-only image inside every translated process,
+ * and reads it for each CPUID a translated program executes. Set the requested bits in
+ * this process's copy of the leaf-7 row.
+ *
+ * WINE_ROSETTA_CPUID7_OR=<ebx bits>[,<ecx bits>] in hex, e.g. 01800000,00400000 for
+ * CLFLUSHOPT + CLWB and RDPID. It is read from the process environment, or for one program
+ * from HKCU\\Software\\Wine\\AppDefaults\\<exe>\\Environment, where a launcher keeps per-game
+ * variables: a game started by a Steam client that was already running does not inherit
+ * the environment of the launch that asked for it. Unset means untouched; a table that
+ * does not look exactly as expected is left alone.
+ */
+static const char *rosetta_cpuid_setting( char *buffer, unsigned int size )
+{
+    static const WCHAR valueW[] = {'W','I','N','E','_','R','O','S','E','T','T','A','_','C','P','U','I','D','7','_','O','R',0};
+    static const WCHAR environmentW[] = {'\\','E','n','v','i','r','o','n','m','e','n','t',0};
+    const char *env = getenv( "WINE_ROSETTA_CPUID7_OR" );
+    char tmp[128];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)tmp;
+    UNICODE_STRING nameW, valuenameW;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE root, key = 0;
+    WCHAR *app_name, *path;
+    unsigned int i, len;
+    DWORD count;
+
+    if (env) return env;
+    if (!main_wargv || !main_wargv[0]) return NULL;
+    if ((app_name = ntdll_wcsrchr( main_wargv[0], '\\' ))) app_name++;
+    else app_name = main_wargv[0];
+    if (open_hkcu_key( "Software\\Wine\\AppDefaults", &root )) return NULL;
+
+    len = wcslen( app_name );
+    if ((path = malloc( (len + ARRAY_SIZE(environmentW)) * sizeof(WCHAR) )))
+    {
+        memcpy( path, app_name, len * sizeof(WCHAR) );
+        memcpy( path + len, environmentW, sizeof(environmentW) );
+        nameW.Buffer = path;
+        nameW.Length = (len + ARRAY_SIZE(environmentW) - 1) * sizeof(WCHAR);
+        InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, root, NULL );
+        /* @@ Wine registry key: HKCU\Software\Wine\AppDefaults\app.exe\Environment */
+        NtOpenKey( &key, KEY_READ, &attr );
+        free( path );
+    }
+    NtClose( root );
+    if (!key) return NULL;
+
+    env = NULL;
+    valuenameW.Buffer = (WCHAR *)valueW;
+    valuenameW.Length = sizeof(valueW) - sizeof(WCHAR);
+    if (!NtQueryValueKey( key, &valuenameW, KeyValuePartialInformation, tmp, sizeof(tmp), &count ) &&
+        info->Type == REG_SZ)
+    {
+        const WCHAR *data = (const WCHAR *)info->Data;
+        len = min( info->DataLength / sizeof(WCHAR), size - 1 );
+        for (i = 0; i < len && data[i]; i++) buffer[i] = (char)data[i];
+        buffer[i] = 0;
+        env = buffer;
+    }
+    NtClose( key );
+    return env;
+}
+
+static void rosetta_extend_cpuid(void)
+{
+    static const unsigned int vendor[3] = { 0x756e6547, 0x6c65746e, 0x49656e69 };  /* "Genu" "ntel" "ineI" */
+    char setting[64];
+    const char *env;
+    mach_vm_address_t addr = 0;
+    mach_vm_size_t size = 0;
+    unsigned int patched = 0;
+
+    unsigned int mask, mask_ecx = 0;
+    char *next;
+
+    if (!is_rosetta2 || !(env = rosetta_cpuid_setting( setting, sizeof(setting) ))) return;
+    mask = strtoul( env, &next, 16 ) & 0x01800000;   /* CLFLUSHOPT, CLWB: nothing else is backed */
+    if (*next == ',') mask_ecx = strtoul( next + 1, NULL, 16 ) & 0x00400000;   /* RDPID */
+    if (!mask && !mask_ecx) return;
+    for (;;)
+    {
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t object;
+        unsigned int *p;
+        size_t i, n;
+
+        if (mach_vm_region( mach_task_self(), &addr, &size, VM_REGION_BASIC_INFO_64,
+                            (vm_region_info_t)&info, &count, &object )) break;
+        /* the runtime image: readable and executable, never writable, a few hundred kB */
+        if ((info.protection & (VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE)) == (VM_PROT_READ | VM_PROT_EXECUTE) &&
+            size <= 0x400000)
+        {
+            p = (unsigned int *)addr;
+            n = size / sizeof(*p);
+            for (i = 4; i + 32 < n; i++)
+            {
+                unsigned int *row1 = p + i, *ebx7 = row1 + 6 * 4 + 1;
+                mach_vm_address_t page;
+
+                /* leaf 0 ends in the vendor string, leaf 1 follows, leaf 7 is six rows on */
+                if (row1[-3] != vendor[0] || row1[-2] != vendor[1] || row1[-1] != vendor[2]) continue;
+                if ((row1[0] & 0xfff00000) || !(row1[3] & (1 << 25))) continue;   /* family/model word, SSE in edx */
+                if (ebx7[-1] || (*ebx7 & ~0x128u) || ebx7[1]) continue;  /* eax 0; only the known bits */
+                page = (mach_vm_address_t)ebx7 & ~(mach_vm_address_t)0x3fff;
+                if (mach_vm_protect( mach_task_self(), page, 0x4000, 0, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY )) continue;
+                *ebx7 |= mask;
+                ebx7[1] |= mask_ecx;
+                mach_vm_protect( mach_task_self(), page, 0x4000, 0, VM_PROT_READ | VM_PROT_EXECUTE );
+                patched++;
+            }
+        }
+        addr += size;
+    }
+    if (patched) { rosetta_cpuid7_ebx = mask; rosetta_cpuid7_ecx = mask_ecx; }
+    if (!patched) WARN_(seh)( "Rosetta CPUID table not found, leaf 7 stays as it is\n" );
+    else TRACE_(seh)( "extended leaf 7 in %u Rosetta CPUID table(s): ebx |= %#x, ecx |= %#x\n", patched, mask, mask_ecx );
+}
+#endif
