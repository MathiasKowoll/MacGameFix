+#ifdef __APPLE__
+/* HRAVA_HW_EXEC_BREAKPOINT: stand-in for x86 execution breakpoints under Rosetta 2.
+ *
+ * Rosetta gives a thread no debug registers. A program that arms Dr0-3/Dr7 through a
+ * thread context and then runs into the armed address expects a debug exception there;
+ * copy protection steers its control flow that way and falls into a deliberate endless
+ * fault when the exception never comes.
+ *
+ * The program's code is left untouched, since the same protection also checksums it.
+ * While a breakpoint is armed its page loses execute permission. Entering the page
+ * faults; from there the thread is single-stepped with the trap flag until it reaches
+ * the breakpoint, where the debug exception is reported, or leaves the page, which is
+ * then guarded again.
+ */
+struct sw_breakpoint
+{
+    ULONG_PTR addr;
+    HANDLE    tid;
+    int       prot;      /* unix protection of the page, with execute permission */
+    LONG      armed;
+    LONG      guarded;   /* execute permission currently removed */
+};
+static struct sw_breakpoint sw_breakpoints[16];
+static HANDLE sw_stepping[16];   /* threads single-stepping through a breakpoint page */
+static pthread_mutex_t sw_breakpoint_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+#define SW_BP_PAGE(addr) ((ULONG_PTR)(addr) & ~(ULONG_PTR)0xfff)
+
+static void guard_breakpoint_page( struct sw_breakpoint *bp, BOOL guard )
+{
+    if (guard)
+    {
+        if (!InterlockedCompareExchange( &bp->guarded, 1, 0 ))
+            mprotect( (void *)SW_BP_PAGE(bp->addr), 0x1000, bp->prot & ~PROT_EXEC );
+    }
+    else if (InterlockedCompareExchange( &bp->guarded, 0, 1 ) == 1)
+        mprotect( (void *)SW_BP_PAGE(bp->addr), 0x1000, bp->prot );
 }
 
+static BOOL set_sw_stepping( HANDLE tid, BOOL step )
+{
+    unsigned int i;
 
+    for (i = 0; i < ARRAY_SIZE(sw_stepping); i++)
+    {
+        if (sw_stepping[i] != tid) continue;
+        if (!step) InterlockedCompareExchangePointer( (void **)&sw_stepping[i], 0, tid );
+        return TRUE;
+    }
+    if (!step) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(sw_stepping); i++)
+        if (!InterlockedCompareExchangePointer( (void **)&sw_stepping[i], tid, 0 )) return TRUE;
+    return FALSE;
+}
+
+static BOOL is_sw_stepping( HANDLE tid )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(sw_stepping); i++) if (sw_stepping[i] == tid) return TRUE;
+    return FALSE;
+}
+
+/* bring the guarded pages of the current thread in line with its debug registers;
+ * a breakpoint on the address execution resumes at stays out, as with the resume flag */
+static void sync_sw_breakpoints( struct amd64_thread_data *data, ULONG_PTR resume_rip )
+{
+    HANDLE tid = NtCurrentTeb()->ClientId.UniqueThread;
+    DWORD_PTR dr7, addr[4];
+    ULONG_PTR want[4] = { 0 };
+    unsigned int i, j;
+
+    if (!is_rosetta2 || !data) return;
+    dr7 = data->dr7;
+    addr[0] = data->dr0;
+    addr[1] = data->dr1;
+    addr[2] = data->dr2;
+    addr[3] = data->dr3;
+    for (i = 0; i < 4; i++)
+    {
+        if (!(dr7 & (3 << (i * 2)))) continue;        /* neither L nor G enable bit */
+        if ((dr7 >> (16 + i * 4)) & 0xf) continue;    /* not an execution breakpoint */
+        if (!addr[i] || addr[i] == resume_rip) continue;
+        want[i] = addr[i];
+    }
+
+    pthread_mutex_lock( &sw_breakpoint_mutex );
+    for (j = 0; j < ARRAY_SIZE(sw_breakpoints); j++)
+    {
+        struct sw_breakpoint *bp = &sw_breakpoints[j];
+
+        if (!bp->armed || bp->tid != tid) continue;
+        for (i = 0; i < 4; i++) if (want[i] == bp->addr) break;
+        if (i < 4) { want[i] = 0; continue; }         /* still wanted, already in place */
+        guard_breakpoint_page( bp, FALSE );
+        InterlockedExchange( &bp->armed, 0 );
+        TRACE_(seh)( "removed execution breakpoint at %p\n", (void *)bp->addr );
+    }
+    for (i = 0; i < 4; i++)
+    {
+        MEMORY_BASIC_INFORMATION info;
+
+        if (!want[i]) continue;
+        if (NtQueryVirtualMemory( NtCurrentProcess(), (void *)want[i], MemoryBasicInformation,
+                                  &info, sizeof(info), NULL )) continue;
+        if (info.State != MEM_COMMIT) continue;
+        for (j = 0; j < ARRAY_SIZE(sw_breakpoints); j++)
+        {
+            struct sw_breakpoint *bp = &sw_breakpoints[j];
+
+            if (bp->armed) continue;
+            bp->addr = want[i];
+            bp->tid = tid;
+            bp->prot = PROT_READ | PROT_EXEC;
+            if (info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY))
+                bp->prot |= PROT_WRITE;
+            bp->guarded = 0;
+            InterlockedExchange( &bp->armed, 1 );
+            guard_breakpoint_page( bp, TRUE );
+            TRACE_(seh)( "armed execution breakpoint %u at %p\n", i, (void *)want[i] );
+            break;
+        }
+    }
+    pthread_mutex_unlock( &sw_breakpoint_mutex );
+}
+
+/* report the debug exception of breakpoint bp, hit by its own thread */
+static void raise_sw_breakpoint( struct thread_data *thread, struct sw_breakpoint *bp, ucontext_t *ucontext,
+                                 EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    struct amd64_thread_data *data = amd64_thread_data( thread );
+    ULONG_PTR addr = bp->addr;
+    unsigned int i = 4;
+
+    guard_breakpoint_page( bp, FALSE );
+    InterlockedExchange( &bp->armed, 0 );
+    if (data)
+    {
+        DWORD_PTR dr[4] = { data->dr0, data->dr1, data->dr2, data->dr3 };
+
+        for (i = 0; i < 4; i++) if (dr[i] == addr && (data->dr7 & (3 << (i * 2)))) break;
+        /* what the register reads on hardware: reserved bits set, plus the breakpoint */
+        data->dr6 = 0xffff0ff0 | (i < 4 ? (DWORD_PTR)1 << i : 0);
+    }
+    TRACE_(seh)( "execution breakpoint %u hit at %p\n", i, (void *)addr );
+    EFL_sig(ucontext) &= ~0x100;
+    save_context( thread, xcontext, ucontext );
+    rec->ExceptionCode = EXCEPTION_SINGLE_STEP;
+    rec->ExceptionAddress = (void *)addr;
+    rec->NumberParameters = 0;
+    setup_raise_exception( thread, ucontext, rec, xcontext );
+}
+
+/* a fault on entering a guarded breakpoint page */
+static BOOL handle_sw_breakpoint_fault( struct thread_data *thread, ucontext_t *ucontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    HANDLE tid = NtCurrentTeb()->ClientId.UniqueThread;
+    ULONG_PTR rip = RIP_sig(ucontext);
+    unsigned int j;
+
+    if (!is_rosetta2) return FALSE;
+    for (j = 0; j < ARRAY_SIZE(sw_breakpoints); j++)
+    {
+        struct sw_breakpoint *bp = &sw_breakpoints[j];
+
+        if (!bp->armed || !bp->guarded || SW_BP_PAGE(bp->addr) != SW_BP_PAGE(rip)) continue;
+        if (bp->addr == rip && bp->tid == tid)
+        {
+            raise_sw_breakpoint( thread, bp, ucontext, rec, xcontext );
+            return TRUE;
+        }
+        guard_breakpoint_page( bp, FALSE );
+        if (set_sw_stepping( tid, TRUE )) EFL_sig(ucontext) |= 0x100;
+        leave_handler( thread, ucontext );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* a single-step trap of a thread walking through a breakpoint page */
+static BOOL handle_sw_breakpoint_step( struct thread_data *thread, ucontext_t *ucontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    HANDLE tid = NtCurrentTeb()->ClientId.UniqueThread;
+    ULONG_PTR rip = RIP_sig(ucontext);
+    BOOL inside = FALSE;
+    unsigned int j;
+
+    if (!is_rosetta2 || !is_sw_stepping( tid )) return FALSE;
+    for (j = 0; j < ARRAY_SIZE(sw_breakpoints); j++)
+    {
+        struct sw_breakpoint *bp = &sw_breakpoints[j];
+
+        if (!bp->armed) continue;
+        if (bp->addr == rip && bp->tid == tid)
+        {
+            set_sw_stepping( tid, FALSE );
+            raise_sw_breakpoint( thread, bp, ucontext, rec, xcontext );
+            return TRUE;
+        }
+        if (SW_BP_PAGE(bp->addr) == SW_BP_PAGE(rip)) inside = TRUE;
+    }
+    if (inside) EFL_sig(ucontext) |= 0x100;
+    else
+    {
+        /* left the page: stop stepping and guard it again */
+        set_sw_stepping( tid, FALSE );
+        EFL_sig(ucontext) &= ~0x100;
+        for (j = 0; j < ARRAY_SIZE(sw_breakpoints); j++)
+            if (sw_breakpoints[j].armed) guard_breakpoint_page( &sw_breakpoints[j], TRUE );
+    }
+    leave_handler( thread, ucontext );
+    return TRUE;
+}
+#endif
