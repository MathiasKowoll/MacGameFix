+#ifdef __APPLE__
+/***********************************************************************
+ *           emulate_hw_exec_breakpoint
+ *
+ * HRAVA_HW_EXEC_BREAKPOINT: Rosetta 2 has no x86 debug registers, so an execution
+ * breakpoint a program arms through its exception context (Dr0-3 + Dr7) never fires.
+ * Copy protection relies on it: the handler of a deliberate fault arms a breakpoint on
+ * the faulting instruction and continues, expecting the debug exception that precedes
+ * the instruction on real hardware. Without it the same fault repeats forever.
+ * When a fault arrives at an address an enabled execution breakpoint covers, deliver
+ * the debug exception the CPU would have raised first.
+ */
+static BOOL emulate_hw_exec_breakpoint( struct thread_data *thread, ucontext_t *ucontext,
+                                        EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    struct amd64_thread_data *data = amd64_thread_data( thread );
+    DWORD_PTR dr7, addr[4];
+    unsigned int i;
+
+    if (!is_rosetta2 || !data || !((dr7 = data->dr7) & 0xff)) return FALSE;
+    addr[0] = data->dr0;
+    addr[1] = data->dr1;
+    addr[2] = data->dr2;
+    addr[3] = data->dr3;
+    for (i = 0; i < 4; i++)
+    {
+        if (!(dr7 & (3 << (i * 2)))) continue;        /* neither L nor G enable bit */
+        if ((dr7 >> (16 + i * 4)) & 0xf) continue;    /* not an execution breakpoint */
+        if (addr[i] != RIP_sig(ucontext)) continue;
+        if (EFL_sig(ucontext) & 0x10000)              /* resume flag: skip the breakpoint once */
+        {
+            EFL_sig(ucontext) &= ~0x10000;
+            xcontext->c.EFlags &= ~0x10000;
+            return FALSE;
+        }
+        TRACE_(seh)( "emulating execution breakpoint %u at %p (dr7 %#lx)\n",
+                     i, (void *)addr[i], (unsigned long)dr7 );
+        data->dr6 = 0xffff0ff0 | ((DWORD_PTR)1 << i);
+        xcontext->c.Dr6 = data->dr6;
+        rec->ExceptionCode = EXCEPTION_SINGLE_STEP;
+        rec->ExceptionAddress = (void *)RIP_sig(ucontext);
+        rec->NumberParameters = 0;
+        setup_raise_exception( thread, ucontext, rec, xcontext );
+        return TRUE;
+    }
+    return FALSE;
+}
+#endif
