+/***********************************************************************
+ *           emulate_clwb
+ *
+ * HRAVA_ROSETTA_CLWB: Rosetta 2 has no CLWB (66 0F AE /6 with a memory operand). The
+ * instruction only asks the CPU to write a cache line back; it changes no register, flag
+ * or memory content, so stepping over it is a complete emulation. Active only for a
+ * process whose CPUID leaf 7 was extended with the CLWB bit (see rosetta_extend_cpuid).
+ */
+static inline BOOL emulate_clwb( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[12];
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+    unsigned int pos = 1, mod, rm;
+
+    /* only where CPUID says so too: a program must not see CLWB work while leaf 7 denies it */
+    if (!(rosetta_cpuid7_ebx & (1u << 24)) || len < 4 || instr[0] != 0x66) return FALSE;
+    if ((instr[pos] & 0xf0) == 0x40) pos++;                          /* REX */
+    if (len < pos + 3 || instr[pos] != 0x0f || instr[pos + 1] != 0xae) return FALSE;
+    mod = instr[pos + 2] >> 6;
+    rm = instr[pos + 2] & 7;
+    if (mod == 3 || ((instr[pos + 2] >> 3) & 7) != 6) return FALSE;  /* memory operand, /6 */
+    pos += 3;
+    if (rm == 4)                                                     /* SIB */
+    {
+        if (len < pos + 1) return FALSE;
+        if (mod == 0 && (instr[pos] & 7) == 5) pos += 4;             /* disp32, no base */
+        pos++;
+    }
+    else if (mod == 0 && rm == 5) pos += 4;                          /* rip-relative disp32 */
+    if (mod == 1) pos += 1;
+    else if (mod == 2) pos += 4;
+    if (pos > len) return FALSE;
+
+    RIP_sig(sigcontext) += pos;
+    TRACE_(seh)( "emulated a CLWB instruction\n" );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           emulate_rdpid
+ *
+ * HRAVA_ROSETTA_RDPID: Rosetta 2 has no RDPID, and its RDTSCP returns a constant
+ * (0xaaaaaaab) where a CPU returns the processor number the OS keeps in TSC_AUX.
+ * Programs that find RDPID missing fall back to RDTSCP and use the result as a
+ * processor index; copy protection walks off the end of a per-processor table that way.
+ * Executing RDPID here, with the number Windows would report, keeps them off that path.
+ */
+static inline BOOL emulate_rdpid( ucontext_t *sigcontext, CONTEXT *context )
+{
+    BYTE instr[5];
+    unsigned int len = virtual_uninterrupted_read_memory( (BYTE *)context->Rip, instr, sizeof(instr) );
+    unsigned int pos = 1, reg;
+    ULONG_PTR value;
+    BYTE rex = 0;
+
+    /* only where CPUID says so too (see rosetta_extend_cpuid) */
+    if (!(rosetta_cpuid7_ecx & (1u << 22)) || len < 4 || instr[0] != 0xf3) return FALSE;
+    if ((instr[pos] & 0xf0) == 0x40) rex = instr[pos++];
+    if (len < pos + 3 || instr[pos] != 0x0f || instr[pos + 1] != 0xc7) return FALSE;
+    if ((instr[pos + 2] & 0xf8) != 0xf8) return FALSE;   /* mod = 3, reg = 7 */
+    reg = (instr[pos + 2] & 7) | ((rex & 1) << 3);
+    value = NtGetCurrentProcessorNumber();
+
+    switch (reg)
+    {
+    case 0:  RAX_sig(sigcontext) = value; break;
+    case 1:  RCX_sig(sigcontext) = value; break;
+    case 2:  RDX_sig(sigcontext) = value; break;
+    case 3:  RBX_sig(sigcontext) = value; break;
+    case 4:  RSP_sig(sigcontext) = value; break;
+    case 5:  RBP_sig(sigcontext) = value; break;
+    case 6:  RSI_sig(sigcontext) = value; break;
+    case 7:  RDI_sig(sigcontext) = value; break;
+    case 8:  R8_sig(sigcontext)  = value; break;
+    case 9:  R9_sig(sigcontext)  = value; break;
+    case 10: R10_sig(sigcontext) = value; break;
+    case 11: R11_sig(sigcontext) = value; break;
+    case 12: R12_sig(sigcontext) = value; break;
+    case 13: R13_sig(sigcontext) = value; break;
+    case 14: R14_sig(sigcontext) = value; break;
+    case 15: R15_sig(sigcontext) = value; break;
+    }
+    RIP_sig(sigcontext) += pos + 3;
+    TRACE_(seh)( "emulated an RDPID instruction, processor %lu\n", (unsigned long)value );
+    return TRUE;
+}
 #endif
 
