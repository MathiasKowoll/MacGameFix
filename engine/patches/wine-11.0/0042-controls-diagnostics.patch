+/* With diagnostics=on: how many input reports the pad sent and the longest gap
+ * between two, as they reach winebus, which is the most a game can read of the
+ * pad. On a cable and over Bluetooth alike, for comparing the two and Game Mode
+ * on and off. Counted in windows of 2 s, but said once a minute (the reports, the
+ * average rate, the lowest and highest window and the longest gap), and at once
+ * for the first window, which also names the connection the app reads a
+ * session's from, and for one with a gap of 100 ms or more: a line every 2 s
+ * was most of the log, 9,589 lines of 21,889 on 2026-10-23. */
+static void pad_input_rate(struct iohid_device *impl)
+{
+    UInt64 now = mach_absolute_time();
+    unsigned int gap, rate;
+
+    if (!impl->input_diagnostics) return;
+    if (impl->input_last && now - impl->input_last > impl->input_gap) impl->input_gap = now - impl->input_last;
+    impl->input_last = now;
+    impl->input_count++;
+    if (!impl->input_since) impl->input_since = impl->minute_since = now;
+    if (now - impl->input_since < mgf_pad_ticks(2.0)) return;
+    gap = (unsigned int)(mgf_pad_seconds(impl->input_gap) * 10000);
+    rate = (unsigned int)(impl->input_count / mgf_pad_seconds(now - impl->input_since));
+    if (gap >= 1000 || !impl->rate_told)
+        pad_log("the %s %s sent %u input reports in 2 s, %u a second; the longest gap between two was %u.%u ms\n",
+                impl->bt ? "Bluetooth" : "wired", impl->model, impl->input_count, rate, gap / 10, gap % 10);
+    impl->rate_told = TRUE;
+    impl->minute_count += impl->input_count;
+    if (impl->input_gap > impl->minute_gap) impl->minute_gap = impl->input_gap;
+    if (!impl->minute_low || rate < impl->minute_low) impl->minute_low = rate;
+    if (rate > impl->minute_high) impl->minute_high = rate;
+    impl->input_since = now;
+    impl->input_count = 0;
+    impl->input_gap = 0;
+    if (now - impl->minute_since < mgf_pad_ticks(60.0)) return;
+    gap = (unsigned int)(mgf_pad_seconds(impl->minute_gap) * 10000);
+    pad_log("the %s %s sent %u input reports in %u s, %u a second (2 s windows from %u to %u); the longest gap "
+            "between two was %u.%u ms\n", impl->bt ? "Bluetooth" : "wired", impl->model, impl->minute_count,
+            (unsigned int)(mgf_pad_seconds(now - impl->minute_since)),
+            (unsigned int)(impl->minute_count / mgf_pad_seconds(now - impl->minute_since)),
+            impl->minute_low, impl->minute_high, gap / 10, gap % 10);
+    impl->minute_since = now;
+    impl->minute_count = impl->minute_low = impl->minute_high = 0;
+    impl->minute_gap = 0;
+}
+
+/* With diagnostics=on: each time the game's motor values rise to 4 or more (what
+ * rumble=haptics plays and the motors' own deadband lets through) and each time
+ * they fall back, with how long they stayed up, the strongest and the last
+ * values, heavy then light. A game that never lets them fall shows it here. */
+static void pad_motors_told(struct iohid_device *impl, BYTE heavy, BYTE light)
+{
+    UInt64 now = mach_absolute_time();
+    BOOL on = heavy >= 4 || light >= 4;
+
+    if (!impl->input_diagnostics) return;
+    if (on && !impl->motors_on)
+    {
+        impl->motors_on = TRUE;
+        impl->motors_since = now;
+        impl->motors_peak[0] = heavy;
+        impl->motors_peak[1] = light;
+        pad_log("the game's motors rise: heavy 0x%02x, light 0x%02x\n", heavy, light);
+    }
+    else if (on)
+    {
+        impl->motors_peak[0] = max(impl->motors_peak[0], heavy);
+        impl->motors_peak[1] = max(impl->motors_peak[1], light);
+    }
+    else if (impl->motors_on)
+    {
+        impl->motors_on = FALSE;
+        pad_log("the game's motors fall after %u ms: the strongest heavy 0x%02x, light 0x%02x; the last before 0x%02x, 0x%02x\n",
+                (unsigned int)(mgf_pad_seconds(now - impl->motors_since) * 1000),
+                impl->motors_peak[0], impl->motors_peak[1], impl->motors_last[0], impl->motors_last[1]);
+    }
+    if (on)
+    {
+        impl->motors_last[0] = heavy;
+        impl->motors_last[1] = light;
+    }
+}
