+/* A viewport here never gets a contact: nothing in Wine hands a touch or a precision
+ * touchpad's pointer to Direct Manipulation, so no manipulation starts and no event is sent.
+ * What a program does to set one up is kept and answered, so that one which needs the set-up
+ * to succeed before it opens its window gets its window (one built on GPUI stops with
+ * "initializing Direct Manipulation: Not implemented"; Swofty Launcher, 2026-11-23). */
 struct directviewport
 {
     IDirectManipulationViewport2 IDirectManipulationViewport2_iface;
     LONG ref;
+    DIRECTMANIPULATION_STATUS status;
+    RECT rect;
+    IDirectManipulationViewportEventHandler *handler;
 };
 
