+    TRACE("%p, %ld\n", This, cookie);
+    if (cookie != 1 || !This->handler) return E_INVALIDARG;
+    IDirectManipulationViewportEventHandler_Release(This->handler);
+    This->handler = NULL;
+    return S_OK;
 }
 
