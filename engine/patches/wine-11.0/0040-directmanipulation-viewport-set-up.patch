 {
     struct directviewport *This = impl_from_IDirectManipulationViewport2(iface);
-    FIXME("%p\n", This);
-    return E_NOTIMPL;
+    TRACE("%p\n", This);
+    This->status = DIRECTMANIPULATION_ENABLED;
