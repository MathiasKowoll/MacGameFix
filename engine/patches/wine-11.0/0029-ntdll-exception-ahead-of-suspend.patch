+#ifdef __APPLE__
+/***********************************************************************
+ *           is_ahead_of_handler
+ *
+ * Whether a signal was delivered on top of another handler before that handler ran (see
+ * finish_direct_syscall): the thread is on the signal stack with nothing on it yet. A
+ * fault inside a handler has that handler's frame above it.
+ *
+ * Without this Wine takes the signal trampoline's entry for the place of the exception,
+ * finds it on the signal stack ("nested exception on signal stack") and ends the thread.
+ */
+static inline BOOL is_ahead_of_handler( ucontext_t *ucontext )
+{
+    char *top = (char *)get_signal_stack() + signal_stack_size, *sp = (char *)RSP_sig(ucontext);
+
+    return direct_syscall_deferral && sp < top && sp >= top - 0x80;
+}
+#endif
