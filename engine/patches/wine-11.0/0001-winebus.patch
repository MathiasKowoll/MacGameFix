--- a/dlls/winebus.sys/main.c
+++ b/dlls/winebus.sys/main.c
@@ -370,6 +370,20 @@
 
     swprintf(device->desc.serialnumber, ARRAY_SIZE(device->desc.serialnumber), L"%04x%08x%04x%04x",
              device->index, device->desc.input, device->desc.pid, device->desc.vid);
+}
+
+/* On macOS a USB device's uid is its location ID, which names the port it is plugged
+ * into and is shared by all of its functions. winecoreaudio derives the same container
+ * from it for the device's audio endpoints, so that games can pair a controller with
+ * its audio output through DEVPKEY_Device_ContainerId, as they do on Windows. */
+static BOOL get_usb_container_id(const struct device_desc *desc, GUID *guid)
+{
+    static const GUID usb_location_base = {0, 0x27f2, 0x4948, {0x96, 0x54, 0x15, 0x28, 0x04, 0xaf, 0x63, 0x78}};
+
+    if (desc->bus_type != BUS_TYPE_USB || !desc->uid) return FALSE;
+    *guid = usb_location_base;
+    guid->Data1 = desc->uid;
+    return TRUE;
 }
 
 static void make_unique_container_id(struct device_extension *device)
@@ -377,6 +391,8 @@
     struct device_extension *ext;
     LARGE_INTEGER ticks;
 
+    if (get_usb_container_id(&device->desc, &device->container_id)) return;
+
     LIST_FOR_EACH_ENTRY(ext, &device_list, struct device_extension, entry)
         if (IsEqualGUID(&device->container_id, &ext->container_id)) break;
     if (&ext->entry == &device_list && !IsEqualGUID(&device->container_id, &GUID_NULL)) return;
